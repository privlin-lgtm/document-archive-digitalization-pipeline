.venv/
.git/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.env
data/
document-archive-pipeline-prompts.md

# web/ is a separate Vite app the Python backend image never needs; without
# this, `COPY . .` would pull node_modules (100s of MB) into every build.
web/node_modules/
web/dist/
web/.env

# Real client scans (see eval/real/README.md) must never be baked into an
# image; the `eval` Compose service bind-mounts the folder at run time.
eval/real/
