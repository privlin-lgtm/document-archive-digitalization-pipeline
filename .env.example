# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/document_archive

# OCR backend: tesseract | trocr | textract
OCR_ENGINE=tesseract

# Storage backend for raw/processed images: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/documents
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=

# Celery / broker
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# App
APP_ENV=development
LOG_LEVEL=INFO
