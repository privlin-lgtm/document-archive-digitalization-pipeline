# Database — no default in code; the app fails fast at startup if this is unset.
# CHANGE THE CREDENTIALS before any real deployment; these are local-dev only.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/document_archive
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# OCR backend: tesseract | trocr | textract
OCR_ENGINE=tesseract

# Storage backend for raw/processed images: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/documents
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
MAX_UPLOAD_SIZE_BYTES=52428800
# Max files accepted in a single POST /documents request (separate from the
# per-file size cap above).
MAX_FILES_PER_UPLOAD=20

# Celery / broker
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# API rate limiting (review_api.rate_limit) — a separate Redis DB index
# from the Celery broker/result-backend above, so keys never collide.
RATE_LIMIT_REDIS_URL=redis://redis:6379/2
RATE_LIMIT_DEFAULT=60/minute

# review_api auth — required, no default. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REVIEW_API_TOKEN=change-me-generate-a-real-token

# App
APP_ENV=development
LOG_LEVEL=INFO
