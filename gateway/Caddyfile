:80 {
	# HSTS is deliberately omitted: this gateway isn't TLS-enabled by default
	# (see README's "Security & production hardening" section), and sending
	# Strict-Transport-Security over plain HTTP is a no-op at best and a
	# self-inflicted lockout at worst once TLS *is* turned on incorrectly.
	# Add it alongside the real certificate config, not before.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'"
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy app:8000 {
			# Overwrite, not append: Caddy's default reverse_proxy behavior
			# appends the real client IP to any X-Forwarded-For the client
			# already sent, so a client-supplied value survives at the front
			# of the header. The app trusts this header's *last* hop when
			# TRUSTED_PROXY_IPS is configured for this gateway -- overwriting
			# here means that hop can only ever be the real remote address,
			# never something the client injected.
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}

	handle {
		reverse_proxy web:80
	}
}
